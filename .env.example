# PostgreSQL connection string.
# If you use Vercel Postgres or Neon, copy the connection string they give you here.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Used by NextAuth to sign session tokens. Generate one with:
# openssl rand -base64 32
NEXTAUTH_SECRET="replace-this-with-a-random-string"

# The URL your site runs at. For local dev, leave as is.
# For production on Vercel, set this to your live URL (e.g. https://your-app.vercel.app)
NEXTAUTH_URL="http://localhost:3000"
